TRACKFLOW_JWT_SECRET_KEY=replace-with-a-secure-random-secret
TRACKFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=30
TRACKFLOW_DATABASE_PATH=data/app.json
TRACKFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001,http://localhost:3002
TRACKFLOW_RESEND_API_KEY=
TRACKFLOW_PASSWORD_RESET_FROM_EMAIL=TrackFlow <onboarding@resend.dev>
TRACKFLOW_PASSWORD_RESET_APP_URL=http://localhost:3000
TRACKFLOW_PASSWORD_RESET_EXPIRE_MINUTES=30
SUPABASE_URI=

# Telemetry KPI pipeline (Prefect Cloud + Docker worker)
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=
PREFECT_WORK_POOL=trackflow-docker-pool
PREFECT_WORKER_TYPE=docker

# Nightly telemetry script (DEV-53) — cron in scripts/crontab / docker-compose `nightly-telemetry`
NIGHTLY_TELEMETRY_CRON=0 2 * * *
# Optional backfill date for scripts/nightly_telemetry.py (defaults to yesterday UTC)
# TARGET_DATE=2026-06-30

# Async task queue (DEV-55) — Redis broker + Celery worker + Flower (dev)
# Inside Docker Compose use hostname `redis`; from host use `localhost`.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_MAX_RETRIES=2
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=300
CELERY_TASK_TIME_LIMIT_SECONDS=360
FLOWER_PORT=5555
# Set to 1 in pytest to run tasks synchronously without Redis.
# CELERY_TASK_ALWAYS_EAGER=1

# RAG / Knowledge Base (Hito 7)
# From host: http://localhost:6333 | Inside Docker Compose api service: http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trackflow_knowledge
# Optional — required only for Qdrant Cloud
QDRANT_API_KEY=

# LiteLLM — unified provider for embeddings and answer generation (OpenRouter)
# Put your OpenRouter API key here; used for both embed and completion calls.
LITELLM_API_KEY=
LITELLM_API_BASE=https://openrouter.ai/api/v1
# LiteLLM model strings: openrouter/<provider>/<model>
# Embedding: https://openrouter.ai/perplexity/pplx-embed-v1-0.6b (native dim 1024)
RAG_EMBEDDING_MODEL=openrouter/perplexity/pplx-embed-v1-0.6b
RAG_LLM_MODEL=openrouter/deepseek/deepseek-v4-flash
# Must match the embedding model output dimension (1024 for pplx-embed-v1-0.6b)
RAG_EMBEDDING_DIMENSION=1024
RAG_TOP_K=3
RAG_KNOWLEDGE_SOURCE_DIR=docs/rag

# TrackFlow MCP (Variant B — MCP Auth library on :8002)
# Agent uses langchain-mcp-adapters against this URL (Bearer JWT).
TRACKFLOW_MCP_URL=http://localhost:8002/mcp
# Optional explicit token; if empty the API mints a local HS256 JWT with MCP_AUTH_*.
TRACKFLOW_MCP_TOKEN=
MCP_AUTH_MODE=local
MCP_AUTH_ISSUER=http://localhost:8002/oidc
MCP_AUTH_RESOURCE=http://localhost:8002/mcp
MCP_AUTH_JWT_SECRET=trackflow-mcp-dev-secret-change-me
MCP_AUTH_ALLOW_DEV_TOKEN=1
MCP_PORT=8002
AGENT_TOOL_TIMEOUT_SECONDS=5
