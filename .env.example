TRACKFLOW_JWT_SECRET_KEY=replace-with-a-secure-random-secret
TRACKFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=30
TRACKFLOW_DATABASE_PATH=data/app.json
TRACKFLOW_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001
TRACKFLOW_RESEND_API_KEY=
TRACKFLOW_PASSWORD_RESET_FROM_EMAIL=TrackFlow <onboarding@resend.dev>
TRACKFLOW_PASSWORD_RESET_APP_URL=http://localhost:3000
TRACKFLOW_PASSWORD_RESET_EXPIRE_MINUTES=30
SUPABASE_URI=

# Telemetry KPI pipeline (Prefect Cloud + Docker worker)
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/<account-id>/workspaces/<workspace-id>
PREFECT_API_KEY=
PREFECT_WORK_POOL=trackflow-docker-pool
PREFECT_WORKER_TYPE=docker
PIPELINE_CRON=0 2 * * *